@page "/tasks"
@using TaskFlow.Models
@inject ITaskRepository TaskRepository
@inject List<string> FoundCommands
<PageTitle>Görevler</PageTitle>

<h1>Görevlerim</h1>
<p><em>Reflection ile bulunan komutlar: @string.Join(", ", FoundCommands)</em></p>
<p>
    Toplam görev: @tasks.Count |
    Tamamlanan: @tasks.Count(t => t.IsCompleted) |
    Bekleyen: @tasks.Count(t => !t.IsCompleted)
</p>

<ul>
    @foreach (var task in tasks)
    {
        <li style="@(task.IsCompleted ? "text-decoration: line-through;" : "")">
            @task.GetSummary()

            @if (task.Priority == TaskPriority.High || task.Priority == TaskPriority.Critical)
            {
                <strong> (ÖNEMLİ)</strong>
            }

            @if (!task.IsCompleted && task.DueDate < DateTime.Now)
            {
                <span style="color: red;"> - SÜRESİ GEÇTİ</span>
            }
        </li>
    }
</ul>

@code {
    private List<TaskItem> tasks = new();
    protected override async Task OnInitializedAsync()
    {
        tasks = TaskRepository.GetAll();
        TaskRepository.TaskCompleted += OnTaskCompleted;

        var first = tasks.FirstOrDefault();
        if (first is not null)
        {
            var found = await TaskRepository.GetByIdAsync(first.Id);
            Console.WriteLine($"Async ile bulunan görev: {found?.Title}");
        }

        using var logger = new TaskLogger();
        logger.Log("Görevler sayfası açıldı");
        logger.Log($"Toplam {tasks.Count} görev bulundu");
    }
    private void OnTaskCompleted(TaskItem task)
    {
        Console.WriteLine($"Bildirim: '{task.Title}' tamamlandı!");
    }
}