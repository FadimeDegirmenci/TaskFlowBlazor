@page "/tasks"
@using TaskFlow.Models

<PageTitle>Görevler</PageTitle>

<h1>Görevlerim</h1>

<p>
    Toplam görev: @tasks.Count |
    Tamamlanan: @tasks.Count(t => t.IsCompleted) |
    Bekleyen: @tasks.Count(t => !t.IsCompleted)
</p>

<ul>
    @foreach (var task in tasks)
    {
        <li style="@(task.IsCompleted ? "text-decoration: line-through;" : "")">
            @task.GetSummary()

            @if (task.Priority == TaskPriority.High || task.Priority == TaskPriority.Critical)
            {
                <strong> (ÖNEMLİ)</strong>
            }

            @if (!task.IsCompleted && task.DueDate < DateTime.Now)
            {
                <span style="color: red;"> - SÜRESİ GEÇTİ</span>
            }
        </li>
    }
</ul>

@code {
    private List<TaskItem> tasks = new();

    protected override void OnInitialized()
    {
        tasks.Add(new PersonalTask("Spor salonuna git", TaskPriority.Low) { Location = "Fitness Center", DueDate = DateTime.Now.AddDays(1) });
        tasks.Add(new TeamTask("Sunum hazırla", TaskPriority.Critical, "Fadime") { DueDate = DateTime.Now.AddDays(-1) });
        tasks.Add(new TeamTask("Kod incelemesi yap", TaskPriority.High, "Mehmet Hoca") { DueDate = DateTime.Now.AddDays(3) });
        tasks.Add(new PersonalTask("Kitap oku", TaskPriority.Medium) { DueDate = DateTime.Now.AddDays(7), IsCompleted = true });
    }
}

